# SlotSync Environment Configuration Template
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/slotsync
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional AI Provider (Gemini API). 
# If left blank, the application seamlessly utilizes its deterministic structured engine.
GEMINI_API_KEY=
